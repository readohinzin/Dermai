{
  "functions": {
    "api/skin-analysis.js": {
      "maxDuration": 60
    },
    "api/skin-simulation.js": {
      "maxDuration": 60
    },
    "api/makeup-vto.js": {
      "maxDuration": 60
    },
    "api/hair-vto.js": {
      "maxDuration": 60
    },
    "api/admin-stats.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
