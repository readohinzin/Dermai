# Clé Perfect Corp : côté serveur uniquement (variables d'environnement Vercel).
# Ne jamais la mettre dans le HTML, le JS du navigateur ou Git.
PERFECT_CORP_API_KEY=

# Verrou de l'endpoint /api/skin-analysis. Désactivé par défaut : sans "1", aucune analyse
# (donc aucun crédit Perfect Corp consommé). À activer seulement pendant un test.
DERMAI_ANALYSIS_ENABLED=

# Mode démo du frontend (lu côté serveur par /api/config-js, par environnement Vercel).
# Vide ou absent = démo (comportement actuel). "false" = appelle le backend. À réserver à une Preview de test.
DERMAI_DEMO_MODE=

# Diagnostic uniquement : "1" renvoie le JSON brut Perfect Corp au navigateur. Laisser vide en production.
DERMAI_DEBUG_RAW=

# Simulation cosmétique avant/après (/api/skin-simulation). FERMÉE par défaut : sans "1", aucune simulation, aucun crédit.
# À définir UNIQUEMENT sur l'environnement Preview de test, jamais en Production. Voir docs/simulation-real-test.md.
DERMAI_SIMULATION_ENABLED=
# Identifiants Supabase autorisés, séparés par des virgules. Vide = personne (même verrou ouvert).
# « * » (seul) = tout compte connecté : choix délibéré, quota PAR compte, pas de plafond global.
DERMAI_SIMULATION_ALLOWED_USER_IDS=
# Quota propre aux simulations (défaut : 1 par 24 h). Ne jamais l'augmenter pour « réessayer ».
DERMAI_MAX_SIMULATIONS_PER_PERIOD=
DERMAI_SIMULATION_PERIOD_HOURS=
# Intensité de la simulation, de 0.1 à 1 (défaut 0.8). 0 = photo d'origine, 1 = effet maximal. Valeur invalide : défaut.
DERMAI_SIMULATION_INTENSITY=

# Studio Beauté (/api/makeup-vto, AI Makeup Virtual Try-On). FERMÉ par défaut : sans "1", aucun essayage, aucune photo lue, aucun crédit.
# À définir UNIQUEMENT sur l'environnement Preview de test. Exige aussi la fonction SQL reserve_makeup (supabase/proposals/20261012120000_makeup_quota.sql, NON appliquée).
DERMAI_MAKEUP_ENABLED=
# Identifiants Supabase autorisés, séparés par des virgules. Vide = personne (même verrou ouvert). « * » (seul) = tout compte connecté : choix délibéré.
DERMAI_MAKEUP_ALLOWED_USER_IDS=
# Quota propre au maquillage (défaut : 3 par 24 h), indépendant de l'analyse et de la simulation. Ne jamais l'augmenter pour « réessayer ».
DERMAI_MAX_MAKEUP_PER_PERIOD=
DERMAI_MAKEUP_PERIOD_HOURS=

# Studio Beauté, volet capillaire (/api/hair-vto : coiffure, couleur, extensions, franges, ondulations, volume). FERMÉ par défaut : sans "1", aucun essai, aucune photo lue, aucun crédit.
# Exige la fonction SQL reserve_hair (supabase/proposals/20261013120000_hair_quota.sql, NON appliquée). Le maquillage garde ses propres variables ci-dessus.
DERMAI_HAIR_ENABLED=
# Identifiants Supabase autorisés, séparés par des virgules. Vide = personne (même verrou ouvert). « * » (seul) = tout compte connecté : choix délibéré.
DERMAI_HAIR_ALLOWED_USER_IDS=
# Quota propre aux essais capillaires, en UNITÉS Perfect Corp documentées (défaut : 6 par 24 h ; coiffure et volume : 2, les autres : 1). Ne jamais l'augmenter pour « réessayer ».
DERMAI_MAX_HAIR_UNITS_PER_PERIOD=
DERMAI_HAIR_PERIOD_HOURS=
# Fonctions ouvertes (liste d'identifiants : hairstyle, haircolor, extensions, bangs, wavy, volume). Vide = toutes celles dont le chemin REST est confirmé (hairstyle, haircolor).
DERMAI_HAIR_FEATURES=
# « 1 » ouvre aussi extensions, bangs, wavy, volume, dont le chemin REST n'est confirmé par aucune source officielle consultée (un 404 du fournisseur ne coûte alors rien). Un chemin
# peut être corrigé sans toucher au code : DERMAI_HAIR_PATH_EXTENSIONS, _BANGS, _WAVY, _VOLUME (forme /s2s/v2.0/task/<nom>).
DERMAI_HAIR_ALLOW_UNCONFIRMED=

# Page d'administration privée du fondateur (/api/admin-stats, lecture seule). Liste FERMÉE d'identifiants de comptes Supabase (UUID) séparés par des virgules ;
# le fondateur le trouve dans Supabase, Authentication, Users, colonne UID. Vide, absente ou invalide (entrée non UUID) = personne. « * » n'a AUCUN effet ici : il invalide la liste.
# Tout autre compte reçoit un 404 sans contenu. Ne jamais commiter de vraie valeur.
DERMAI_ADMIN_USER_IDS=
